---
import heroData from "../data/hero.json";

const socialLinks = [
  {
    href: heroData.social.github,
    label: "GitHub",
    icon: "M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z",
  },
  {
    href: heroData.social.linkedin,
    label: "LinkedIn",
    icon: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
  },
  {
    href: heroData.social.orcid,
    label: "ORCID",
    icon: "M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378c.525 0 .947.431.947.947s-.422.947-.947.947a.95.95 0 0 1-.947-.947c0-.525.422-.947.947-.947zm-.722 3.038h1.444v10.041H6.647V7.416zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.016-5.325 5.016h-3.919V7.416zm1.444 1.303v7.444h2.297c2.359 0 4.053-1.303 4.053-3.722 0-2.403-1.694-3.722-4.053-3.722h-2.297z",
  },
  {
    href: heroData.social.scholar,
    label: "Google Scholar",
    icon: "M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z",
  },
  {
    href: heroData.social.twitter,
    label: "X",
    icon: "M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z",
  },
];

const focusTags = [
  "Microbiome",
  "Multi-omics",
  "Reproducible tools",
  "AI-guided analysis",
];
---

<section
  class="relative px-4 sm:px-6 lg:px-8 pt-4 sm:pt-8 lg:pt-10 pb-8 sm:pb-12 lg:pb-16 lg:min-h-[calc(100vh-5rem)] flex items-center overflow-hidden"
>
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-br from-secondary via-white to-secondary/50 opacity-60"
  >
  </div>
  <div
    class="absolute inset-0 -z-10 bg-[radial-gradient(#617056_1px,transparent_1px)] [background-size:16px_16px] opacity-[0.03]"
  >
  </div>

  <div class="max-w-7xl mx-auto w-full">
    <div class="grid lg:grid-cols-[0.85fr_1.15fr] gap-4 sm:gap-8 lg:gap-16 items-center">
      <div class="flex justify-center lg:justify-start reveal reveal-delay-100">
        <div class="w-32 h-32 sm:w-72 sm:h-72 lg:w-[28rem] lg:h-[28rem]">
          <img
            id="hero-image"
            src={heroData.image.src}
            alt={heroData.image.alt}
            class="w-full h-full object-contain opacity-0 transition-opacity duration-700 ease-out"
          />
        </div>
      </div>

      <div class="text-center lg:text-left">
        <p class="text-[0.68rem] sm:text-sm font-semibold uppercase tracking-[0.14em] sm:tracking-[0.16em] text-primary-dark mb-2 sm:mb-4 reveal reveal-delay-100">
          Bioinformatics · microbiome · translational data science
        </p>

        <h1 class="text-[2rem] sm:text-5xl lg:text-6xl font-serif font-bold text-slate-900 mb-2 sm:mb-5 leading-tight reveal reveal-delay-200">
          {heroData.name}
        </h1>

        <div class="min-h-[2.75rem] sm:min-h-[4rem] mb-3 sm:mb-6 reveal reveal-delay-300">
          <p
            id="typing-text"
            class="text-[1.55rem] sm:text-3xl lg:text-4xl font-handwritten text-primary font-medium leading-tight"
            data-text={heroData.title}
          >
            <span id="typed-content"></span>
            <span id="cursor" class="animate-pulse">|</span>
          </p>
        </div>

        <p class="text-sm sm:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto lg:mx-0 mb-4 sm:mb-7 reveal reveal-delay-300">
          I build reproducible analyses and data tools to understand how
          microbial communities shape immunity, infection and inflammation.
          <span class="hidden sm:inline">
            My work connects microbiome research, epigenetics, multi-omics and
            modern AI into clear evidence for scientific and clinical decisions.
          </span>
        </p>

        <div class="hidden sm:flex flex-wrap justify-center lg:justify-start gap-2 mb-8 reveal reveal-delay-300">
          {
            focusTags.map((tag) => (
              <span class="px-3 py-1.5 rounded-lg bg-white/80 border border-primary/15 text-sm font-medium text-primary-dark">
                {tag}
              </span>
            ))
          }
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-2 sm:gap-3 mb-5 sm:mb-7 reveal reveal-delay-300">
          <a
            href="/contact"
            class="inline-flex w-full sm:w-auto justify-center items-center px-4 sm:px-5 py-2.5 sm:py-3 bg-primary hover:bg-primary-dark text-white text-sm sm:text-base font-medium rounded-lg transition-colors duration-200 shadow-sm hover:shadow-md"
          >
            Discuss a collaboration
          </a>
          <a
            href="/projects"
            class="inline-flex w-full sm:w-auto justify-center items-center px-4 sm:px-5 py-2.5 sm:py-3 bg-white border border-slate-200 hover:border-primary/40 text-slate-800 hover:text-primary text-sm sm:text-base font-medium rounded-lg transition-colors duration-200 shadow-sm hover:shadow-md"
          >
            View research projects
          </a>
          <a
            href={heroData.social.cv}
            download
            class="inline-flex w-full sm:w-auto justify-center items-center px-4 sm:px-5 py-1.5 sm:py-3 text-primary hover:text-primary-dark text-sm sm:text-base font-medium transition-colors duration-200"
          >
            Download CV
          </a>
        </div>

        <div class="flex justify-center lg:justify-start gap-3 sm:gap-4 reveal reveal-delay-300">
          {
            socialLinks.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-slate-500 hover:text-primary transition-colors duration-200"
                aria-label={link.label}
                title={link.label}
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d={link.icon}></path>
                </svg>
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <button
      id="scroll-to-projects"
      class="hidden sm:block mt-8 lg:mt-10 animate-bounce text-center mx-auto cursor-pointer hover:text-primary transition-colors duration-200"
      aria-label="Scroll to research focus"
    >
      <svg
        class="w-6 h-6 mx-auto text-slate-400 hover:text-primary transition-colors duration-200"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M19 9l-7 7-7-7"></path>
      </svg>
    </button>
  </div>
</section>

<script>
  const heroImage = document.getElementById(
    "hero-image",
  ) as HTMLImageElement | null;
  if (heroImage) {
    setTimeout(() => {
      heroImage.classList.remove("opacity-0");
      heroImage.classList.add("opacity-100");
    }, 300);
  }

  const typingText = document.getElementById("typing-text");
  const typedContent = document.getElementById("typed-content");

  if (typingText && typedContent) {
    const text = typingText.dataset.text || "";
    let index = 0;
    const typingSpeed = 50;
    const startDelay = 500;

    function typeText() {
      if (index < text.length && typedContent) {
        typedContent.textContent += text.charAt(index);
        index++;
        setTimeout(typeText, typingSpeed);
      }
    }

    setTimeout(typeText, startDelay);
  }

  const scrollButton = document.getElementById("scroll-to-projects");
  if (scrollButton) {
    scrollButton.addEventListener("click", () => {
      const nextSection = document.getElementById("research-focus");
      nextSection?.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  }
</script>

<style>
  #cursor {
    display: inline-block;
    animation: blink 1s infinite;
  }

  @keyframes blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }
</style>
